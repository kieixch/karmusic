# KarMusic environment configuration
#
# The default online catalog (Free To Use, https://freetouse.com/api) has a
# public, keyless API. No configuration is required for it.
#
# Optional: Jamendo provider. Create an application at
# https://developer.jamendo.com/v3.0 to obtain a client id, then set it here.
# The value is only read by server-side route handlers and is never shipped
# to the browser. Leave empty to disable the Jamendo provider.
JAMENDO_CLIENT_ID=

# Optional: set to "false" to hide the Free To Use catalog in the UI.
# (The API remains keyless; this is a product switch, not a credential.)
NEXT_PUBLIC_ENABLE_FREETOUSE=true

# Public production URL used for metadata. Optional.
# On Vercel, KarMusic automatically falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
