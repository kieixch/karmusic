{
  "name": "KarMusic — Free music player with landscape lyrics",
  "short_name": "KarMusic",
  "description": "A free, local-first music player with a royalty-free online catalog, local audio imports and fullscreen landscape lyrics.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#08090a",
  "theme_color": "#08090a",
  "categories": ["music", "entertainment", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-29.jpeg",
      "sizes": "400x400",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore online music",
      "short_name": "Explore",
      "url": "/explore",
      "description": "Browse royalty-free music categories"
    },
    {
      "name": "Search everything",
      "short_name": "Search",
      "url": "/search",
      "description": "Search your library and the online catalog"
    },
    {
      "name": "Now playing",
      "short_name": "Player",
      "url": "/now-playing",
      "description": "Open the full player and lyrics"
    }
  ]
}
